# --- AI (required for AI briefings, drafts and fact-check; the app falls back to
# extractive summaries without it) ---
ANTHROPIC_API_KEY=
# Model used for writing, briefings and fact-check.
CODEBLUE_MODEL=claude-opus-5-5
# Cheaper model for bulk work (daily digests, story labels).
CODEBLUE_FAST_MODEL=claude-haiku-5-5

# --- Optional news APIs (free backbone works without these) ---
# The Guardian Open Platform: full archive back to 1999 (free key: open-platform.theguardian.com)
GUARDIAN_API_KEY=
# NewsData.io: 80k+ sources, many African outlets (newsdata.io)
NEWSDATA_API_KEY=

# --- Ingestion ---
# Google News edition used for topic feeds and searches
CODEBLUE_NEWS_HL=en-US
CODEBLUE_NEWS_GL=US
# Minutes between top-source polls / long-tail polls by the worker
CODEBLUE_POLL_FAST_MIN=5
CODEBLUE_POLL_SLOW_MIN=30
# Hour (0-23, server local time) to build the daily digest and refresh subjects
CODEBLUE_DAILY_HOUR=6

# SQLite database path
CODEBLUE_DB=./data/codeblue.db

# --- Access ---
# Set a password before putting Code Blue on the internet (browser login).
CODEBLUE_PASSWORD=
CODEBLUE_USER=admin
